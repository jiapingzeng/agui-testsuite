{
  "name": "agui-testsuite",
  "version": "1.0.0",
  "description": "Test suite for OpenSearch AI agent features",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "ts-node src/index.ts --parallel",
    "setup": "ts-node src/index.ts --setup-only",
    "test:openai": "ts-node src/index.ts --test-openai --parallel",
    "test:bedrock": "ts-node src/index.ts --test-bedrock --parallel",
    "test:all": "ts-node src/index.ts --test-all --parallel",
    "clean": "rm -rf outputs/*",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "opensearch",
    "testing",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^2.5.0",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.3.1"
  }
}
