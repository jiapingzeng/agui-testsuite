OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_USERNAME=xxxxx
OPENSEARCH_PASSWORD=xxxxx

OPENAI_API_KEY=xxxxx
MCP_SERVER_URL=http://localhost:3030

# AWS Credentials - Two approaches supported:

# Option 1: Use AWS_CREDENTIALS_COMMAND to run a command that outputs credentials in KEY=VALUE format
# AWS_CREDENTIALS_COMMAND=xxxxx

# Option 2: Directly set the credentials (in .env or as environment variables)
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_SESSION_TOKEN=xxxxx

# Generated by setup (do not set manually)
OPENAI_MODEL_ID=xxxxx
OPENAI_AGENT_ID=xxxxx
BEDROCK_MODEL_ID=xxxxx
BEDROCK_AGENT_ID=xxxxx
MCP_CONNECTOR_ID=xxxxx
